# Copy to .env (docker compose reads it) or export in your shell for local dev.

# First-run platform admin: seeded ONLY when the users table is empty.
# Forced password change on first sign-in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now

# Tenancy: clubs live at <slug>.<BASE_DOMAIN>. Requests on other hosts
# (localhost included) fall back to DEFAULT_CLUB.
BASE_DOMAIN=fleety.live
DEFAULT_CLUB=invicta

# ADSBexchange rescue tier (optional). With a RapidAPI key set, aircraft whose
# open flight vanishes from BOTH free networks get probed against ADSBx — one
# request per aircraft, max 2 per cycle, min 2 minutes between probes of the
# same aircraft, all under a hard monthly budget (default 9000 = headroom
# under the 10k/month Basic plan). Without a key this tier is simply off.
ADSBX_API_KEY=
ADSBX_MONTHLY_BUDGET=9000

# Outbound email via Resend (invites + password resets). Optional — without a
# key, admins get shareable links instead of emails being sent.
# Verify the sending domain in Resend first (DNS records on fleety.live).
RESEND_API_KEY=
EMAIL_FROM="Fleety <ops@fleety.live>"

# Where SQLite db, uploads and backups live (inside the container this is /data)
DATA_DIR=./data

# Port the app listens on
PORT=8080

# Domain Caddy should serve when using the bundled docker-compose (not needed
# on Coolify — its proxy handles TLS, including the *.fleety.live wildcard).
SITE_DOMAIN=fleety.live
