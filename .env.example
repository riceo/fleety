# Copy to .env (docker compose reads it) or export in your shell for local dev.

# First-run admin account: seeded ONLY when the users table is empty.
# The admin is forced to change this password on first login.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

# Where SQLite db, uploads and backups live (inside the container this is /data)
DATA_DIR=./data

# Port the app listens on
PORT=8080

# Domain Caddy should serve (docker-compose / Caddyfile)
SITE_DOMAIN=tracker.example.org
